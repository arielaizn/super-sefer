{
  "name": "super-sefer",
  "productName": "סופר-ספר",
  "version": "1.0.0",
  "description": "סופר-ספר — מערכת מלאה ליצירת ספרים מקצה לקצה: כתיבה, עריכה, הגהה, עימוד, כריכה, איורים וייצוא PDF",
  "main": "main.js",
  "author": "סופר-ספר",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "fonts": "node scripts/build-fonts.js",
    "icons": "node scripts/make-icons.js",
    "dist:mac": "electron-builder --mac --universal",
    "dist:win": "electron-builder --win --x64"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "diff": "^8.0.0",
    "marked": "^15.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.0.0"
  },
  "devDependencies": {
    "@fontsource/alef": "^5.3.0",
    "@fontsource/amatic-sc": "^5.3.0",
    "@fontsource/assistant": "^5.3.0",
    "@fontsource/bellefair": "^5.3.0",
    "@fontsource/david-libre": "^5.3.0",
    "@fontsource/frank-ruhl-libre": "^5.3.0",
    "@fontsource/heebo": "^5.3.0",
    "@fontsource/miriam-libre": "^5.3.0",
    "@fontsource/noto-sans-hebrew": "^5.3.0",
    "@fontsource/noto-serif-hebrew": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@fontsource/secular-one": "^5.3.0",
    "@fontsource/suez-one": "^5.3.0",
    "@fontsource/varela-round": "^5.3.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "studio.supersefer.app",
    "productName": "סופר-ספר",
    "copyright": "סופר-ספר",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "src/**",
      "cli/**",
      "ui/**",
      "fonts/**",
      "knowledge/**",
      "node_modules/**",
      "!node_modules/.cache",
      "!**/*.map",
      "!node_modules/pdfjs-dist/legacy/web/**",
      "!node_modules/pdfjs-dist/web/**",
      "!node_modules/pdfjs-dist/types/**",
      "!node_modules/pdfjs-dist/image_decoders/**",
      "!node_modules/@fontsource/**",
      "!node_modules/@napi-rs/**"
    ],
    "asarUnpack": [
      "fonts/**",
      "node_modules/pdfjs-dist/**"
    ],
    "extraResources": [
      {
        "from": "plugins",
        "to": "plugins"
      }
    ],
    "artifactName": "Super-Sefer-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "סופר-ספר ${version}",
      "iconSize": 110,
      "window": {
        "width": 560,
        "height": 360
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "include": "build/installer.nsh",
      "language": "1037",
      "installerLanguages": [
        "he_IL"
      ]
    }
  }
}